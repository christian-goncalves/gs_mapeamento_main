    "sheets:reset-ata-records:dry-run": "tsx --env-file=.env.local scripts/reset-ata-record-sheets.ts",
    "sheets:reset-ata-records": "tsx --env-file=.env.local scripts/reset-ata-record-sheets.ts --execute",
