# Autenticacao da aplicacao (cliente OAuth proprio para Auth.js)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_ALLOWED_EMAILS=

# Persistencia no Google Sheets (somente no servidor)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Simulacao mensal de atas: usa o GOOGLE_SHEETS_ID local (DEV)
ATA_SIMULATION_ENABLED=false

# Politica de edicao manual das abas do contrato
MANUAL_SHEETS_EDIT_ENABLED=true

# E-mails transacionais via Resend
RESEND_API_KEY=
EMAIL_FROM=GS Mapeamento <gs-mapeamento@reuniaovirtual.online>
NEW_USER_NOTIFICATION_EMAIL=chrisapppg1@gmail.com
